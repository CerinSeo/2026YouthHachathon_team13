{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bingbingzero",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-05-01",
  "secrets": { "required": ["TMAP_APP_KEY"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
